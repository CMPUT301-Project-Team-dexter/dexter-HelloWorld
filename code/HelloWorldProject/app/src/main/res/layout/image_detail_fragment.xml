<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/debug_wide_img"
        android:layout_margin="20dp"
        android:maxHeight="400dp"
        android:scaleType="fitCenter"

        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintTop_toTopOf="parent">

    </ImageView>

    <TextView
        android:id="@+id/uploader_label"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/image"
        app:layout_constraintEnd_toStartOf="@id/uploader_name"
        app:layout_constraintStart_toStartOf="@id/image"
        android:text="Uploader: "
        android:textSize="20sp">
    </TextView>

    <TextView
        android:id="@+id/uploader_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/image"
        app:layout_constraintStart_toEndOf="@id/uploader_label"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="AlphaBravo"
        android:textSize="20sp">
    </TextView>

    <TextView
        android:id="@+id/uploader_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/uploader_name"
        app:layout_constraintStart_toStartOf="@id/uploader_name"
        app:layout_constraintEnd_toEndOf="@id/uploader_name"
        android:text="alpha #27"
        android:textSize="20sp"
        android:textColor="@android:color/darker_gray">
    </TextView>

    <Button
        android:id="@+id/delete_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:maxHeight="200dp"
        android:text="Delete"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </Button>

</androidx.constraintlayout.widget.ConstraintLayout>