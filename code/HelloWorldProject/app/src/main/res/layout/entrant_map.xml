<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:locale="en">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="@string/entrants_map_title"
        tools:title="Entrants Map"
        android:titleTextColor="@android:color/white"
        app:titleCentered="false" />

    <!-- Map placeholder (for now just a visual box) -->
    <FrameLayout
        android:id="@+id/mapPlaceholder"
        android:layout_below="@id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:background="#DDDDDD"
        android:gravity="center">

        <!-- Centered icon & text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_map_marker"
                app:tint="#9E9E9E"
                android:contentDescription="@string/map_placeholder_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_placeholder_label"
                tools:text="Map Placeholder"
                android:textColor="#9E9E9E"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
