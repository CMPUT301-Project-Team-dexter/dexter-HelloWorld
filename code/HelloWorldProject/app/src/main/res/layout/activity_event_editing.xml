<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="eventModel"
            type="com.example.helloworldproject.model.Event" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.activities.HomeActivity">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/evt_ed_toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="Event Edit"
            app:titleTextColor="@color/white" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/evt_ed_toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="16dp" >

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/evt_ed_poster_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/debug_card_image" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:padding="12sp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#66000000"
                                android:padding="4sp"
                                android:text="@string/tap_to_update_poster"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </FrameLayout>

                    <View
                        android:id="@+id/evt_ed_poster_clickable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:importantForAccessibility="no" />

                    <ImageButton
                        android:id="@+id/evt_ed_delete_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8sp"
                        android:background="@drawable/bg_icon_circle_dim"
                        android:contentDescription="@string/delete_event"

                        android:src="@drawable/ic_close"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingLeft="16sp"
                    android:paddingRight="16sp">

                    <TextView
                        android:id="@+id/evt_ed_title_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:drawablePadding="4sp"
                        android:text="@{eventModel.title}"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_pen" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Register Period"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="12sp"
                        android:paddingBottom="4sp">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="From: "
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/evt_ed_reg_start_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4sp"
                                android:text="@{com.example.helloworldproject.model.Event.formatDate(eventModel.registrationOpenAt)}"
                                android:textSize="20sp"
                                app:drawableStartCompat="@drawable/ic_calender" />

                        </TableRow>

                        <TableRow
                            android:id="@+id/TableRow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="To: "
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/evt_ed_reg_end_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4sp"
                                android:text="@{com.example.helloworldproject.model.Event.formatDate(eventModel.registrationCloseAt)}"
                                android:textSize="20sp"
                                app:drawableStartCompat="@drawable/ic_calender" />
                        </TableRow>

                    </TableLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Event Period"

                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="12sp"
                        android:paddingBottom="4sp">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="From: "
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/evt_ed_event_start_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4sp"
                                android:text="@{com.example.helloworldproject.model.Event.formatDate(eventModel.eventStartAt)}"
                                android:textSize="20sp"
                                app:drawableStartCompat="@drawable/ic_calender" />
                        </TableRow>

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="To: "
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/evt_ed_event_end_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4sp"
                                android:text="@{com.example.helloworldproject.model.Event.formatDate(eventModel.eventEndAt)}"
                                android:textSize="20sp"
                                app:drawableStartCompat="@drawable/ic_calender" />
                        </TableRow>

                    </TableLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="4sp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:text="Location: "
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/evt_ed_location_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4sp"
                            android:text="@{eventModel.venue}"
                            android:textSize="20sp"
                            app:drawableStartCompat="@drawable/ic_pen" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Geolocation limit: "
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/evt_ed_geo_limit_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="@{eventModel.geoRequired}" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="4sp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:text="Event Capacity: "
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/evt_ed_capacity_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4sp"
                            android:text="@{String.valueOf(eventModel.capacity)}"
                            android:textSize="20sp"
                            app:drawableStartCompat="@drawable/ic_pen" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="4sp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"

                            android:text="Waiting list capacity: "
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/evt_ed_wait_list_limit_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4sp"
                            android:text="@{String.valueOf(eventModel.plannedSampleSize)}"
                            android:textSize="20sp"
                            app:drawableStartCompat="@drawable/ic_pen" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/evt_ed_desc_title_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:drawablePadding="4sp"
                        android:text="Description"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_pen" />

                    <TextView
                        android:id="@+id/evt_ed_desc_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{eventModel.description}"
                        android:textSize="20sp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>