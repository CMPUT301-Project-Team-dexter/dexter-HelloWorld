<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="@string/sample_event"
        android:titleTextColor="@android:color/white"
        app:titleCentered="false">

        <ImageButton
            android:id="@+id/filterButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_filter"
            android:contentDescription="@string/filter_events"
            app:tint="@android:color/white" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Scrollable area (poster + details) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollArea"
        android:layout_below="@id/topAppBar"
        android:layout_above="@+id/bottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Poster section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/posterCard"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Poster image -->
                    <ImageView
                        android:id="@+id/posterImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/debug_card_image"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no" />

                    <!-- Tap overlay hint -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:padding="12dp"
                        android:background="#40000000">

                        <TextView
                            android:id="@+id/updatePosterHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tap_to_update_poster"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:background="#66000000"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>

                    <!-- Admin-only close button -->
                    <ImageButton
                        android:id="@+id/deletePosterButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_icon_circle_dim"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        android:contentDescription="@string/delete_event"
                        app:tint="@android:color/white"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Clickable overlay (trigger update poster) -->
                    <View
                        android:id="@+id/posterClickableOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Registration period -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/registration_period"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/registrationPeriodValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_reg_period"
                            android:textColor="#444444" />
                    </LinearLayout>

                    <!-- Event period -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/event_period"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/eventPeriodValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_event_period"
                            android:textColor="#444444" />
                    </LinearLayout>

                    <!-- Geolocation requirement -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/geolocation_requirement"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/geoSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:enabled="false"
                            android:contentDescription="@string/geolocation_requirement" />
                    </LinearLayout>

                    <!-- Capacity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/capacity"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/capacityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textColor="#444444" />
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/description"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:paddingTop="8dp" />

                    <TextView
                        android:id="@+id/descriptionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_description"
                        android:textColor="#444444"
                        android:paddingTop="4dp" />

                    <!-- Waiting list -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/waiting_list"
                            android:textStyle="bold"
                            android:textColor="#222222" />

                        <TextView
                            android:id="@+id/waitingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12/50"
                            android:textColor="#444444" />
                    </LinearLayout>

                    <!-- Organizer edit hint -->
                    <TextView
                        android:id="@+id/organizerEditHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/organizer_can_edit"
                        android:textColor="#666666"
                        android:paddingTop="12dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <Button
                        android:id="@+id/btn_lottery_rules"
                        android:text="View lottery rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Admin-only delete FAB (garbage bin) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/adminDeleteFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:contentDescription="@string/delete_event"
        app:backgroundTint="@color/red_600"
        app:srcCompat="@drawable/outline_delete_128"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/bottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- JOIN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/join"
            android:text="@string/join"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:iconPadding="8dp"
            tools:visibility="visible" />

        <!-- LEAVE -->
<!--        <com.google.android.material.button.MaterialButton-->
<!--            android:id="@+id/btnLeave"-->
<!--            style="@style/Widget.MaterialComponents.Button"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="48dp"-->
<!--            android:layout_marginTop="8dp"-->
<!--            android:contentDescription="@string/leave"-->
<!--            android:text="@string/leave"-->
<!--            android:textColor="@android:color/white"-->
<!--            android:visibility="gone"-->
<!--            app:backgroundTint="@color/red_600"-->
<!--            app:cornerRadius="12dp" />-->

        <!-- Progress group -->
        <LinearLayout
            android:id="@+id/progressGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

<!--            <com.google.android.material.button.MaterialButton-->
<!--                android:id="@+id/btnPending"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="48dp"-->
<!--                android:enabled="false"-->
<!--                android:text="@string/pending"-->
<!--                app:cornerRadius="12dp" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/accept"
                    app:cornerRadius="12dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/decline"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/red_600"
                    app:cornerRadius="12dp" />
            </LinearLayout>

<!--            <com.google.android.material.button.MaterialButton-->
<!--                android:id="@+id/btnCancelInvitation"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="48dp"-->
<!--                android:layout_marginTop="8dp"-->
<!--                android:text="@string/cancel_invitation"-->
<!--                android:textColor="@android:color/white"-->
<!--                app:backgroundTint="@color/red_600"-->
<!--                app:cornerRadius="12dp" />-->

<!--            <com.google.android.material.button.MaterialButton-->
<!--                android:id="@+id/btnWaitNext"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="48dp"-->
<!--                android:layout_marginTop="8dp"-->
<!--                android:text="@string/wait_for_next_time"-->
<!--                app:cornerRadius="12dp" />-->
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
